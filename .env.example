# Copy to ".env" and set your own values (do not commit real secrets)
#
# PowerShell:
#   Copy-Item .env.example .env
#   # then edit .env and set a new SECRET_KEY

# Flask session signing key
SECRET_KEY=change-me-to-a-long-random-string

# Optional local LLM settings (only used if llama-cpp-python is installed and the model exists)
LLM_MODEL_PATH=models/koala-7B-HF.Q3_K_L.gguf
LLM_N_CTX=512
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7

# Optional cloud LLM (Sixfinger) settings
# - Set LLM_PROVIDER=sixfinger to force cloud usage
# - Set LLM_PROVIDER=auto to prefer Sixfinger if API key is set, otherwise use local GGUF
LLM_PROVIDER=auto
SIXFINGER_API_KEY=sixfinger_iqdd4z71y2b0wxigwhrk
SIXFINGER_MODEL=qwen3-32b

# Flask dev server
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
