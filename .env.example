# Copy to ".env" and set your own values (do not commit real secrets)
#
# PowerShell:
#   Copy-Item .env.example .env
#   # then edit .env and set a new SECRET_KEY

# Flask session signing key
SECRET_KEY=change-me-to-a-long-random-string

# Optional local LLM settings (only used if llama-cpp-python is installed and the model exists)
LLM_MODEL_PATH=models/koala-7B-HF.Q3_K_L.gguf
LLM_N_CTX=512
LLM_MAX_TOKENS=150
LLM_TEMPERATURE=0.7

# Optional external LLM (OpenAI-compatible) settings
# - Set LLM_PROVIDER=external to force cloud usage
# - Set LLM_PROVIDER=auto to prefer external if API key + URL are set, otherwise use local GGUF
LLM_PROVIDER=auto
EXTERNAL_API_URL=https://api.openai.com/v1/chat/completions
EXTERNAL_API_KEY=your-api-key
EXTERNAL_API_MODEL=gpt-4o-mini

# Flask dev server
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000
